{
  "_comment": "Notion 映射样例。凭据绝不写在此文件，统一从 NOTION_TOKEN 环境变量读取（参见 user memory 的 Notion 直连规则）。本文件只描述字段映射与数据库 ID，且数据库 ID 也可改用环境变量 NOTION_DB_ID。",
  "token_env": "NOTION_TOKEN",
  "database_id_env": "NOTION_DB_ID",
  "database_id_example": "00000000-0000-0000-0000-000000000000",
  "title_property": "选题标题",
  "properties": {
    "状态": { "type": "select", "value": "已发布" },
    "发布渠道": { "type": "multi_select", "value": ["微信", "LinkedIn", "独立页"] },
    "生成时间": { "type": "date", "value": "{{ISO_TIMESTAMP}}" }
  },
  "idempotency": {
    "key_property": "选题标题",
    "strategy": "upsert_by_title"
  }
}
